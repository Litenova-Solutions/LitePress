{
  "name": "litepress",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:aspire": "dotnet run --project apps/api/src/LitePress.AppHost",
    "dev:stop": "pwsh scripts/dev-aspire-stop.ps1",
    "dev:api": "dotnet run --project apps/api/src/LitePress.WebApi",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "db:migrate": "dotnet run --project apps/api/src/LitePress.WebApi -- --apply-schema-only",
    "db:reset": "pwsh scripts/db-reset.ps1",
    "db:reset:aspire": "pwsh scripts/db-reset.ps1 -Aspire",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "generate:api-types": "pnpm --filter @litepress/api-types generate:api-types"
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "typescript": "^6.0.3"
  }
}
