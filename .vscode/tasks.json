{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "bootstrap",
      "type": "shell",
      "command": "pwsh",
      "args": ["-File", "${workspaceFolder}/scripts/bootstrap.ps1"],
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "db:migrate",
      "type": "shell",
      "command": "pnpm",
      "args": ["db:migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "dev:aspire",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev:aspire"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
