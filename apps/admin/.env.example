# Copy to .env.local and fill in real values for GitHub OAuth sign-in.
# cp .env.example .env.local
#
# When using Aspire, API_URL is injected automatically. Other vars can also be
# set via AppHost user secrets (see docs/technical/environment.md).

API_URL=http://localhost:5000
API_JWT_SECRET=dev-secret-key-must-be-at-least-32-characters-long!
AUTH_SECRET=dev-auth-secret-must-be-at-least-32-characters-long!!
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret
GITHUB_OWNER_ID=your-numeric-github-user-id
