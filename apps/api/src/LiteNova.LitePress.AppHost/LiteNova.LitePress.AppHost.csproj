<Project Sdk="Aspire.AppHost.Sdk/13.3.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>blog-apphost</UserSecretsId>
    <!--
      Suppress Aspire experimental-API diagnostics.
      AddNextJsApp is marked [Experimental("ASPIREJAVASCRIPT001")] in Aspire 13.
    -->
    <NoWarn>$(NoWarn);ASPIREJAVASCRIPT001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteNova.LitePress.WebApi\LiteNova.LitePress.WebApi.csproj" />
  </ItemGroup>

</Project>
